---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { profile, skillGroups } from '../data/profile';
import { url } from '../lib/paths';
import { Image } from 'astro:assets';
import portrait from '../assets/mos-portrait.png';
---

<SiteLayout title="About" active="About">
  <section class="about-intro container">
    <div>
      <h1>About me</h1>
      <p class="lead">
        Pratchayaphong Thananta
        <br />
        <strong>Game Developer & QA Tester</strong>
      </p>
      <p>{profile.introduction}</p>
      <p>
        My student projects include solo development, team programming, and
        level design. I also completed a QA internship at Jumbo Jump from June
        to October 2026.
      </p>
      <a
        class="button primary"
        href={url('documents/Pratchayaphong_Resume.pdf')}
        download
      >
        Download my résumé <Icon name="download" size={18} />
      </a>
    </div>
    <figure class="about-portrait">
      <Image
        src={portrait}
        alt="Pratchayaphong, also known as Mos, outdoors in a park"
        width={820}
        format="webp"
        quality={85}
        loading="eager"
      />
      <figcaption>
        <span>Pratchayaphong Thananta</span>
        <span class="mono">MOS / มอส</span>
      </figcaption>
    </figure>
  </section>

  <section
    class="section container"
    id="experience"
    aria-labelledby="experience-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / EXPERIENCE</p>
        <h2 id="experience-title">Work experience</h2>
      </div>
    </div>
    <div class="experience-full">
      <div class="experience-period">
        <span class="mono">JUN — OCT 2026</span>
        <p>Android & iOS</p>
      </div>
      <div>
        <p class="eyebrow">JUMBO JUMP</p>
        <h3>Quality Assurance Intern</h3>
        <p>
          I worked on mobile game testing, covering gameplay functionality,
          interfaces, and navigation across Android and iOS.
        </p>
        <ul class="clean-list">
          <li>
            <Icon name="check" size={18} />
            Created and executed test cases for mobile games.
          </li>
          <li>
            <Icon name="check" size={18} />
            Identified bugs and documented test results.
          </li>
          <li>
            <Icon name="check" size={18} />
            Performed regression testing and checked UI behavior.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section
    class="section container skills-section"
    aria-labelledby="skills-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / SKILLS</p>
        <h2 id="skills-title">Skills & tools</h2>
      </div>
    </div>
    <div class="skills-grid">
      {skillGroups.map((group) => (
        <div class="skill-card">
          <span class="mono text-accent">{group.number} /</span>
          <h3>{group.title}</h3>
          <p>{group.description}</p>
          <div class="tags">
            {group.skills.map((skill) => (
              <span>{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="ai-panel">
      <div>
        <h3>AI tools</h3>
        <p>
          I use ChatGPT, Codex, Grok, and Gemini, and have some exposure to
          Claude. I used ChatGPT and Codex to plan and develop this portfolio
          website.
        </p>
      </div>
      <div class="ai-tools">
        <span>ChatGPT</span>
        <span>Codex</span>
        <span>Grok</span>
        <span>Gemini</span>
        <span>
          Claude <small>some exposure</small>
        </span>
      </div>
    </div>
  </section>

  <section
    class="section container education"
    aria-labelledby="education-title"
  >
    <p class="eyebrow">03 / EDUCATION</p>
    <h2 id="education-title">Education</h2>
    <div class="education-row">
      <span class="mono">2023 — 2026</span>
      <div>
        <h3>Chiang Mai University</h3>
        <p>Digital Game · College of Arts, Media and Technology</p>
        <a class="text-link" href="https://www.camt.cmu.ac.th/">
          CAMT website <Icon name="diagonal" size={15} />
        </a>
      </div>
    </div>
    <div class="education-row">
      <span class="mono">2017 — 2023</span>
      <div>
        <h3>Princess Chulabhorn Science High School Chiang Rai</h3>
        <p>Secondary education</p>
      </div>
    </div>
  </section>
</SiteLayout>
